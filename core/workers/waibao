def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("apply", "undo"):
        return (cmd_apply if sys.argv[1] == "apply" else cmd_undo)(sys.argv[2:])
    ap = argparse.ArgumentParser(prog="waibao", description="把任务派给 dsh / kimi 的无头工人")
    ap.add_argument("model", nargs="?", choices=sorted(MODELS), help="flash 走 dsh；k3 / k28 走 kimi")
    ap.add_argument("--dir", help="工人的工作目录，只能在允许外发的范围内；加了 --web 可以不给")
    ap.add_argument("--web", action="store_true",
                    help="联网工人：只有搜索和读网页，读不了本地文件（只对 k3 / k28）；不加就是本地只读，没有联网工具")
    ap.add_argument("--out", help="能写文件的工人（只对 k3 / k28）：只能往这个文件夹里写，它必须在 --dir 里面，没有会新建")
    ap.add_argument("--tag", help="短标签，用在结果文件名和账本里")
    ap.add_argument("--plan", help="一句话：预估操作、成本、规划（记入账本）；超上限的写明用户批准")
    ap.add_argument("--task", help="任务文本；不给则读 --task-file 或标准输入")
    ap.add_argument("--task-file")
    ap.add_argument("--timeout", type=int,
                    help="秒，到点收工；不给就按 预算.json 的 timeout_sec（超长上限），给得更长只提醒不拦")
    ap.add_argument("--dry-run", action="store_true", help="只做检查并打印命令，不调用模型，不记账")
    ap.add_argument("--status", action="store_true", help="看今天的用量")
    a = ap.parse_args()
    cfg = load_cfg()

    if a.status:
        show_status(cfg)
        return 0
    if not a.model:
        raise Refused("缺少模型：flash / k3 / k28。")
    shell = MODELS[a.model]["shell"]
    if a.web and shell != "kimi":
        raise Refused("%s 不接受 --web：联网查资料派 k28 或 k3。" % a.model)
    if a.out and shell != "kimi":
        raise Refused("%s 不接受 --out：要写文件派 k3 或 k28。" % a.model)
    if a.out and a.web:
        raise Refused("--out 和 --web 不能一起用：写文件的工人不联网。")
    if a.timeout is not None and a.timeout <= 0:
        raise Refused("--timeout 要大于 0。")
    for name in ("dir", "tag", "plan"):
        if not getattr(a, name) and not (name == "dir" and a.web):
            raise Refused("缺少 --%s。" % name)
    prof = dict(PROFILES["kimi-web" if a.web else "kimi-write" if a.out else shell])

    if a.web and not a.dir and not os.path.isdir(WEB_DIR):
        raise Refused("联网工作目录不存在：%s" % WEB_DIR)
    cwd = check_dir(a.dir or WEB_DIR, cfg)
    if a.out:
        out = _real(a.out)
        if not _inside(_key(out), _key(cwd)):
            raise Refused("--out 必须在 --dir 里面：%s" % a.out)
        if os.path.exists(out) and not os.path.isdir(out):
            raise Refused("--out 已经是个文件，不是文件夹：%s" % a.out)
        if not os.path.exists(SANDBOX):
            raise Refused("找不到系统沙箱 %s，不能派能写文件的工人。" % SANDBOX)
        if not a.dry_run:
            os.makedirs(out, exist_ok=True)
        prof["out"] = out
    if a.task:
        task = a.task
    elif a.task_file:
        with open(a.task_file, encoding="utf-8") as f:
            task = f.read()
    elif not sys.stdin.isatty():
        task = sys.stdin.read()
    else:
        task = ""
    if not task.strip():
        raise Refused("任务为空。")
    with open(os.path.join(BASE, prof["rules"]), encoding="utf-8") as f:
        rules = f.read().rstrip()
    if prof.get("out"):
        rules = rules.replace("{结果文件夹}", prof["out"])
    text = rules + "\n" + task.strip() + "\n"
    hint = ""
    if not a.web and WEB_HINT.search(task):
        hint = "提醒：任务书里像是要联网，但这次派的是本地工人，没有联网工具；要联网请派 k28 / k3 并加 --web。"

    limit = int(cfg["timeout_sec"])
    timeout = a.timeout or limit
    long_note = ""
    if timeout > limit:
        long_note = "⚠ 这次时限 %d 秒，超过超长上限 %d 秒（只提醒，没拦）" % (timeout, limit)
    tag = re.sub(r"[^\w一-鿿-]+", "-", a.tag).strip("-")[:30] or "任务"
    now = datetime.datetime.now()
    binary = DSH if shell == "dsh" else KIMI
    if not os.path.exists(binary):
        raise Refused("找不到 %s 的命令行：%s" % (shell, binary))

    if a.dry_run:
        with Locked():
            rows = read_rows()
            sweep(rows)
        warn = check_budget(a.model, cfg, rows, now.date().isoformat())
        print("[waibao] 检查通过（未调用模型，未记账）")
        print("  壳/模型：%s / %s   目录：%s" % (shell, a.model, cwd))
        print("  档案：%s（工具只有 %s）" % (prof["name"], "、".join(prof["tools"])))
        if prof.get("out"):
            print("  结果文件夹：%s（系统沙箱只放行这里的写入）" % prof["out"])
        print("  时限：%ds   任务长度：%d 字符" % (timeout, len(text)))
        for x in (hint, warn, long_note):
            if x:
                print("[waibao] " + x)
        return 0

    if hint:
        print("[waibao] " + hint, flush=True)
    os.makedirs(os.path.join(OUT, "原始"), exist_ok=True)
    # 文件名：时间戳 + 六位随机串 + 模型 + 标签。原始记录和结果文件先独占建好（同名就换随机串），
    # 同一秒、同模型、同标签的两次派工也不会互相覆盖；后面往里写的都是自己建的文件。
    ts = now.strftime("%Y%m%d-%H%M%S")
    rawpath, outpath = _claim(lambda h: (os.path.join(OUT, "原始", "%s-%s-%s-%s.jsonl" % (ts, h, a.model, tag)),
                                         os.path.join(OUT, "%s-%s-%s-%s.md" % (ts, h, a.model, tag))))
    rid = uuid.uuid4().hex[:12]
    plan = a.plan + ("（结果文件夹：%s）" % prof["out"] if prof.get("out") else "")
    warn = reserve(a.model, cfg, {"id": rid, "日期": now.date().isoformat(), "开始时间": now.strftime("%H:%M:%S"),
                                  "模型": a.model, "壳": shell, "标签": tag, "目录": cwd, "说明": plan})
    for x in (warn, long_note):
        if x:
            print("[waibao] " + x, flush=True)
    t0 = time.time()
    res = {"status": "中断", "err": "调度脚本异常退出", "final": "", "u": {"in": 0, "cache": 0, "out": 0}}
    audit, serious, audit_failed = [], False, False
    try:
        runner = run_dsh if shell == "dsh" else run_kimi
        res = runner(a.model, cfg, cwd, text, rawpath, timeout, prof)
    finally:
        secs = int(round(time.time() - t0))
        try:
            audit, serious = read_audit(rawpath, cwd, cfg, prof["tools"], prof.get("out"))
        except Exception as e:
            audit, audit_failed = ["‼ 越界审计没跑成：%r" % (e,)], True
        audit += ["？ " + n for n in res.get("notes", [])]
        if serious and res["status"] in ("完成", "失败"):
            res["status"] = "越界"
        u = res["u"]
        money = cost_of(a.model, cfg, u)
        spent, calls = settle(rid, {"状态": res["status"], "耗时秒": str(secs), "输入未缓存": str(u["in"]),
                                    "输入缓存": str(u["cache"]), "输出": str(u["out"]),
                                    "估算花费元": "%.4f" % money, "结果文件": outpath})

    body = res["final"].strip()
    web, wrote = [], []
    if shell == "kimi":
        try:
            web = web_audit(rawpath)
        except Exception as e:
            web, audit_failed = ["‼ 联网审计没跑成：%r" % (e,)], True
    if prof.get("out"):
        try:
            wrote = written_files(rawpath, cwd, prof["out"])
        except Exception as e:
            wrote, audit_failed = ["‼ 写入清单没列成：%r" % (e,)], True
    with open(outpath, "w", encoding="utf-8") as f:                 # 派工前已独占建好，是自己的文件
        f.write("<!-- waibao %s | %s | %s | %ss | 入 %d / 缓存 %d / 出 %d | 估 ¥%.4f | 目录 %s%s -->\n\n"
                % (a.model, res["status"], now.strftime("%Y-%m-%d %H:%M:%S"), secs,
                   u["in"], u["cache"], u["out"], money, cwd,
                   " | 结果文件夹 %s" % prof["out"] if prof.get("out") else ""))
        f.write(body + "\n" if body else "（没有拿到最终回答）\n")
        if audit:
            f.write("\n## 调度器记录的越界（‼ = 禁区、派工范围以外、不该有的工具或写到结果文件夹以外；？ = 没判出来）\n\n"
                    + "\n".join(audit) + "\n")
        if web:
            f.write("\n## 调度器记录的联网（‼ = 过长，需总工核查是否外泄）\n\n" + "\n".join(web) + "\n")
        if wrote:
            f.write("\n## 调度器记录的写入（结果文件夹里）\n\n" + "\n".join(wrote) + "\n")
        if res["err"]:
            f.write("\n## 调度器记录的错误\n\n%s\n" % res["err"])

    today = today_line(a.model, cfg, spent, calls)
    paid = "估 ¥%.4f（按高峰价）" % money if shell == "dsh" else "会员额度"
    print("[waibao] %s · %s · %ds · 入 %d / 缓存 %d / 出 %d · %s · %s"
          % (a.model, res["status"], secs, u["in"], u["cache"], u["out"], paid, today))
    print("[waibao] 全文：%s" % outpath)
    if long_note:
        print("[waibao] " + long_note)
    if a.web:
        print("[waibao] 档案：联网（只有搜索和读网页，读不了本地文件）")
    if prof.get("out"):
        print("[waibao] 档案：本地读写（只能写 %s）；写了 %d 个文件%s"
              % (prof["out"], len(wrote), "：" if wrote else ""))
        for w in wrote[:20]:
            print("  " + w)
        if len(wrote) > 20:
            print("  […还有 %d 个，见全文]" % (len(wrote) - 20))
    if res["err"]:
        print("[waibao] 错误：%s" % res["err"])
    if audit:
        print("[waibao] 越界记录 %d 条（‼ = 禁区、派工范围以外、不该有的工具或写到结果文件夹以外；？ = 没判出来）：" % len(audit))
        print("\n".join(audit))
    if web:
        print("[waibao] 本次联网 %d 次（‼ = 过长，需核查）：" % len(web))
        print("\n".join(web))
    lines = body.splitlines()
    if serious:
        print("[waibao] ‼ 有严重越界：这次的回答当成不可信，这里不打印；要看自己打开全文。")
    elif lines:
        print("---")
        print("\n".join(lines[:RECEIPT_LINES]))
        if len(lines) > RECEIPT_LINES:
            print("[…后面还有 %d 行，见全文]" % (len(lines) - RECEIPT_LINES))
    return 0 if res["status"] == "完成" and not audit_failed else 3


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Refused as e:
        print("[waibao] 拒绝：%s" % e, file=sys.stderr)
        sys.exit(2)
