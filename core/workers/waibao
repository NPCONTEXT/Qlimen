def show_status(cfg):
    today = datetime.date.today().isoformat()
    with Locked():
        rows = read_rows()
        sweep(rows)
        if rows:
            write_rows(rows)
    spent, calls = today_totals(rows, today)
    print("[waibao] 今天 %s（日上限只提醒，不拦）：" % today)
