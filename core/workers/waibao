        print("  " + today_line(m, cfg, spent, calls))
    print("  超长上限：不给 --timeout 时 %d 秒收工；给了可以更长，回执提醒" % int(cfg["timeout_sec"]))
    for r in rows[-8:]:
        print("  %s %s %-5s %s %ss ¥%s  %s" % (r["日期"], r["开始时间"], r["模型"], r["状态"],
