# ---------- 账本 ----------

class Locked(object):
    """所有会话共用一个账本，读写都在文件锁里做。"""

    def __enter__(self):
        os.makedirs(os.path.dirname(LEDGER), exist_ok=True)
        self.f = open(LEDGER + ".lock", "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


def read_rows():
    if not os.path.exists(LEDGER):
        return []
    with open(LEDGER, encoding="utf-8-sig", newline="") as f:
        return list(csv.DictReader(f))


def write_rows(rows):
    tmp = LEDGER + ".tmp"
    with open(tmp, "w", encoding="utf-8-sig", newline="") as f:
        w = csv.DictWriter(f, fieldnames=FIELDS)
        w.writeheader()
        w.writerows(rows)
    os.replace(tmp, LEDGER)


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except (OSError, ValueError):
        return False
    return True


def sweep(rows):
    """调度进程已不在却还标着运行中的行，改成中断；预留的花费保留，宁可多算。"""
    for r in rows:
        if r["状态"] == "运行中" and not pid_alive(r["pid"]):
            r["状态"] = "中断"


def today_totals(rows, today):
    """返回（今天 DeepSeek 估算花费，{kimi 模型: 今天次数}）。"""
    spent = sum(float(r["估算花费元"] or 0) for r in rows if r["日期"] == today and r["壳"] == "dsh")
    calls = {}
    for r in rows:
        if r["日期"] == today and r["壳"] == "kimi":
            calls[r["模型"]] = calls.get(r["模型"], 0) + 1
    return spent, calls


def check_budget(model, cfg, rows, today):
    """派工前看日上限：到了就返回一句提醒，没到返回空串。只提醒，不拦（2026-10-09 用户定）。"""
    spent, calls = today_totals(rows, today)
    if MODELS[model]["shell"] == "dsh":
        daily = float(cfg["deepseek_daily_cny"])
        if spent >= daily - 1e-9:
            return "⚠ 今天 DeepSeek 已计 ¥%.2f，已到日上限 ¥%.2f（只提醒，没拦）" % (spent, daily)
        return ""
    limit = int(cfg["kimi_daily_calls"][model])
    n = calls.get(model, 0)
    if n + 1 > limit:
        return "⚠ 这是今天第 %d 次 %s，超过日上限 %d 次（只提醒，没拦）" % (n + 1, model, limit)
    return ""


def today_line(model, cfg, spent, calls):
    """回执里的「今日用量」，超了日上限带一句提醒。"""
    if MODELS[model]["shell"] == "dsh":
        daily = float(cfg["deepseek_daily_cny"])
        over = spent > daily + 1e-9
        return "今日 DeepSeek ¥%.2f / ¥%.2f%s" % (spent, daily, "  ⚠ 超过日上限（只提醒）" if over else "")
    limit, n = int(cfg["kimi_daily_calls"][model]), calls.get(model, 0)
    return "今日 %s %d / %d 次%s" % (model, n, limit, "  ⚠ 超过日上限（只提醒）" if n > limit else "")


def reserve(model, cfg, meta):
    """账本里先记一行「运行中」，返回日上限提醒（没到上限是空串）。"""
    today = meta["日期"]
    with Locked():
        rows = read_rows()
        sweep(rows)
        warn = check_budget(model, cfg, rows, today)
        row = dict((k, "") for k in FIELDS)
        row.update(meta)
        row.update({"状态": "运行中", "估算花费元": "0.0000", "pid": str(os.getpid())})
        rows.append(row)
        write_rows(rows)
    return warn


def settle(rid, upd):
    with Locked():
        rows = read_rows()
        for r in rows:
            if r["id"] == rid:
                r.update(upd)
        write_rows(rows)
        return today_totals(rows, datetime.date.today().isoformat())


# ---------- 目录检查 ----------

def _real(p):
    return os.path.realpath(os.path.expanduser(p))


def _inside(p, root):
    return p == root or p.startswith(root + os.sep)


def check_dir(d, cfg):
    real = _real(d)
    if not os.path.isdir(real):
        raise Refused("目录不存在：%s" % d)
    for root in cfg["deny_roots"]:
        root = _real(root)
        if _inside(real, root):
            raise Refused("该目录在禁区内，不派工。")
        if _inside(root, real):
            raise Refused("该目录下面包含禁区，请指定更具体的子目录。")
    if not any(_inside(real, _real(r)) for r in cfg["allow_roots"]):
        raise Refused("该目录不在允许外发的范围内（见 预算.json 的 allow_roots）。")
    return real


# ---------- 跑工人 ----------

def cost_of(model, cfg, u):
    p = cfg["prices_cny_per_mtok"].get(model)
    if not p:
        return 0.0
    return (u["in"] * p["in"] + u["cache"] * p["cache"] + u["out"] * p["out"]) / 1e6


def _spawn(cmd, cwd, env, errf, stdin):
    return subprocess.Popen(cmd, cwd=cwd, env=env, stdin=stdin, stdout=subprocess.PIPE, stderr=errf,
                            universal_newlines=True, encoding="utf-8", errors="replace",
                            start_new_session=True)


def _killer(proc, flag):
    def kill(why):
        flag.setdefault("why", why)       # 先到先得：越界、超时、中断谁先发生就记谁
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
    return kill


def _calls(ev):
    """一行事件里的工具调用：[(工具名, 参数)]。两种壳的格式都认；参数解不出来给 None。"""
    out = []
    if not isinstance(ev, dict):
        return out
    if ev.get("type") == "tool_call":                        # dsh
        out.append((ev.get("tool"), ev.get("input")))
    tcs = ev.get("tool_calls")                               # kimi
    for tc in tcs if isinstance(tcs, list) else []:
        if not isinstance(tc, dict):
            continue
        fn = tc.get("function")
        fn = fn if isinstance(fn, dict) else {}
        args = fn.get("arguments")
        if isinstance(args, str):
            try:
                args = json.loads(args)
            except ValueError:
                args = None
        out.append((fn.get("name"), args))
    return out


def _write_ok(name, args, cwd, out):
    """写文件的调用是不是落在结果文件夹里；判不出路径也算不是。"""
    if not out:
        return False
    paths = _targets(name, args)
    if not paths:
        return False
    for p in paths:
        if "\x00" in p:
            return False
        full = os.path.expanduser(p)
        if not os.path.isabs(full):
            full = os.path.join(cwd or "/", full)
        if not _inside(_key(os.path.realpath(full)), _key(out)):
            return False
    return True


def _alarm(ev, allowed, kill, flag, cwd=None, out=None):
    """工人用了名单以外的工具、或往结果文件夹以外写，就当场中止。自己出错只记一笔，不拖累读输出的循环。"""
    try:
        bad = []
        for n, args in _calls(ev):
            if n not in allowed:
                bad.append(str(n))
            elif n in WRITE_TOOLS and not _write_ok(n, args, cwd, out):
                bad.append("%s（写到结果文件夹以外，或判不出写到哪）" % n)
        if bad:                                              # 同一条消息里的全部记下再杀
            flag.setdefault("bad", []).extend(bad)
            kill("越界")
    except Exception as e:
        flag.setdefault("notes", []).append("工具报警出错：%r" % (e,))


def sandbox_profile(out):
    """系统沙箱规则（sandbox-exec）：写入只放行结果文件夹、kimi 工人数据目录、临时目录和 /dev，别处一律挡掉。"""
    allow = [out, WORKER_ENV.get("KIMI_CODE_HOME"), "/private/tmp", "/private/var/folders", "/dev"]

    def q(p):
        return '"%s"' % p.replace("\\", "\\\\").replace('"', '\\"')
    subs = " ".join("(subpath %s)" % q(os.path.realpath(p)) for p in allow if p)
    return "(version 1)(allow default)(deny file-write*)(allow file-write* %s)" % subs


def _read_failed(kill, err, e):
    """读工人输出时出了没料到的错：杀掉工人（状态先到先得），把错记下来，由调用方照常收尾。
    工人是另起会话启动的，不杀就没人管；已经拿到的回答和用量照样交出去。"""
    kill("中断")
    return "；".join(x for x in (err, "读工人输出时出错：%r" % (e,)) if x)


def run_dsh(model, cfg, cwd, text, rawpath, timeout, prof):
    cmd = [DSH, "headless", "--patch", DSH_PATCH, "--json", "-"]
    env = dict(os.environ, DSH_PERMISSION_MODE="read-only", **WORKER_ENV)
    u = {"in": 0, "cache": 0, "out": 0}
    final, err, flag = None, None, {}
    with open(rawpath, "w", encoding="utf-8") as raw, open(rawpath + ".err", "w") as errf:
        p = _spawn(cmd, cwd, env, errf, subprocess.PIPE)
        kill = _killer(p, flag)
        timer = threading.Timer(timeout, kill, ["超时"])
        timer.start()
        try:
            try:
                p.stdin.write(text)
                p.stdin.close()
            except (BrokenPipeError, OSError):
                pass
            for line in p.stdout:
                raw.write(line)
                raw.flush()
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(ev, dict):
                    continue
                _alarm(ev, prof["tools"], kill, flag)
                t = ev.get("type")
                if t == "status" and ev.get("phase") == "step_end" and isinstance(ev.get("usage"), dict):
                    g = ev["usage"]
                    u["in"] += int(g.get("inputTokens") or 0) + int(g.get("cacheWriteTokens") or 0)
                    u["cache"] += int(g.get("cacheReadTokens") or 0)
                    u["out"] += int(g.get("outputTokens") or 0)
                elif t == "status" and ev.get("phase") == "turn_end":
                    reason = ev.get("reason") or {}
                    if reason.get("kind") == "error":
                        err = (reason.get("error") or {}).get("message") or "未知错误"
                elif t == "final":
                    final = ev.get("text")
        except Exception as e:
            err = _read_failed(kill, err, e)
        except BaseException:                 # 被打断（如 Ctrl-C）：不要结果，但不能留下工人
            kill("中断")
            p.wait()
            raise
        finally:
            timer.cancel()
        rc = p.wait()
    return finish(flag, err, rc, final, u, rawpath)


def kimi_usage(sid):
    u = {"in": 0, "cache": 0, "out": 0}
    if not sid:
        return u
    for w in glob.glob(os.path.join(KIMI_SESSIONS, "*", sid, "agents", "main", "wire.jsonl")):
        with open(w, encoding="utf-8", errors="replace") as f:
            for line in f:
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                if ev.get("type") == "usage.record" and isinstance(ev.get("usage"), dict):
                    g = ev["usage"]
                    u["in"] += int(g.get("inputOther") or 0) + int(g.get("inputCacheCreation") or 0)
                    u["cache"] += int(g.get("inputCacheRead") or 0)
                    u["out"] += int(g.get("output") or 0)
    return u


def run_kimi(model, cfg, cwd, text, rawpath, timeout, prof):
    cmd = [KIMI, "-p", text, "-m", MODELS[model]["alias"],
           "--agent-file", os.path.join(BASE, prof["agent"]), "--output-format", "stream-json"]
    out = prof.get("out")
    if out:                                   # 能写文件的工人：写入由系统沙箱限定在结果文件夹
        cmd = [SANDBOX, "-p", sandbox_profile(out)] + cmd
    final, sid, err, flag = None, None, None, {}
    with open(rawpath, "w", encoding="utf-8") as raw, open(rawpath + ".err", "w") as errf:
        p = _spawn(cmd, cwd, dict(os.environ, **WORKER_ENV), errf, subprocess.DEVNULL)
        kill = _killer(p, flag)
        timer = threading.Timer(timeout, kill, ["超时"])
        timer.start()
        try:
            for line in p.stdout:
                raw.write(line)
                raw.flush()
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(ev, dict):
                    continue
                _alarm(ev, prof["tools"], kill, flag, cwd, out)
                if ev.get("role") == "assistant":
                    c = ev.get("content")
                    if isinstance(c, list):
                        c = "".join(x.get("text", "") for x in c if isinstance(x, dict))
                    if isinstance(c, str) and c.strip():
                        final = c
                elif ev.get("role") == "meta" and ev.get("type") == "session.resume_hint":
                    sid = ev.get("session_id")
        except Exception as e:
            err = _read_failed(kill, err, e)
        except BaseException:                 # 被打断（如 Ctrl-C）：不要结果，但不能留下工人
            kill("中断")
            p.wait()
            raise
        finally:
            timer.cancel()
        rc = p.wait()
    return finish(flag, err, rc, final, kimi_usage(sid), rawpath)


WEB_TOOLS = {"WebSearch": "query", "FetchURL": "url"}


def web_audit(rawpath):
    """从 kimi 原始日志里抽出本次全部搜索词和 URL；过长的标红，供总工过目。"""
    out = []
    try:
        f = open(rawpath, encoding="utf-8", errors="replace")
    except OSError:
        return out
    with f:
        for line in f:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            # 形状不对的一律跳过或原样列出，不许出错：这里一出错，结果文件就写不出来
            tcs = ev.get("tool_calls") if isinstance(ev, dict) else None
            for tc in tcs if isinstance(tcs, list) else []:
                fn = tc.get("function") if isinstance(tc, dict) else None
                name = fn.get("name") if isinstance(fn, dict) else None
                key = WEB_TOOLS.get(name) if isinstance(name, str) else None
                if not key:
                    continue
                raw = fn.get("arguments") or "{}"
                args = raw
                if isinstance(raw, str):
                    try:
                        args = json.loads(raw)
                    except ValueError:
                        args = None
                val = str(args.get(key, "")) if isinstance(args, dict) else str(raw)
                qs = val.split("?", 1)[1] if key == "url" and "?" in val else ""
                bad = len(val) > 100 if key == "query" else len(qs) > 100
                out.append(("‼ " if bad else "  ") + "%s: %s" % (name, val))
    return out


# ---------- 越界审计：工人跑完以后翻原始记录，不碰读输出的循环 ----------

def _where(path, cwd, cfg):
    """路径落在哪：None 工作目录内；「普通」目录外但在派工范围内；「严重」禁区内或派工范围以外。"""
    if "\x00" in path:
        raise ValueError("路径里有空字符")
    full = os.path.expanduser(path)
    if not os.path.isabs(full):
        full = os.path.join(cwd, full)
    k = _key(os.path.realpath(full))
    if _inside(k, _key(cwd)):
        return None
    if any(_inside(k, _key(_real(d))) for d in cfg["deny_roots"]):
        return "严重"
    if not any(_inside(k, _key(_real(r))) for r in cfg["allow_roots"]):
        return "严重"
    return "普通"


def _glob_dir(pattern):
    """通配符写法里能确定的目录那一段（"" 表示就在起点目录）；判不了返回 None。"""
    if pattern.startswith(("{", "[")):
        return None
    m = re.search(r"[*?\[{]", pattern)
    if not m:
        return pattern
    head, rest = pattern[:m.start()], pattern[m.start():]
    if ".." in rest.split("/"):
        return None
    return head.rsplit("/", 1)[0] + "/" if "/" in head else ""


def _targets(name, args):
    """这次调用碰了哪些路径；判不出来返回 None。"""
    if not isinstance(args, dict):
        return None
    base = None
    for k in ("file_path", "path"):
        if k in args:
            if not isinstance(args[k], str) or not args[k].strip():
                return None
            base = args[k]
    if name in ("Glob", "glob"):
        pat = args.get("pattern")
        d = _glob_dir(pat) if isinstance(pat, str) else None
        if d is None:
            return None
        if base is None or os.path.isabs(os.path.expanduser(d)):
            return [d or "."]
        return [os.path.join(base, d)]
    if base is None:
        return ["."] if name in ("Grep", "grep") else None
    return [base]


def _short(args):
    try:
        s = json.dumps(args, ensure_ascii=False)
    except (TypeError, ValueError):
        s = repr(args)
    return s if len(s) <= 160 else s[:160] + "…"


def written_files(rawpath, cwd, out):
    """能写文件的工人往结果文件夹里写了哪些文件（按调用顺序去重）。"""
    res = []
    with open(rawpath, encoding="utf-8", errors="replace") as f:
        for raw in f:
            try:
                ev = json.loads(raw)
            except ValueError:
                continue
            for name, args in _calls(ev):
                if name in WRITE_TOOLS and _write_ok(name, args, cwd, out):
                    for p in _targets(name, args):
                        full = os.path.expanduser(p)
                        full = full if os.path.isabs(full) else os.path.join(cwd, full)
                        if full not in res:
                            res.append(full)
    return res


def read_audit(rawpath, cwd, cfg, allowed, out=None):
    """工人读过哪些工作目录以外的地方、用过哪些名单以外的工具、往结果文件夹以外写过什么。
    返回（给人看的行，有没有严重的）。"""
    lines, seen, serious = [], set(), False

    def add(mark, kind, name, what):
        line = "%s %s %s: %s" % (mark, kind, name, what)
        if line not in seen:
            seen.add(line)
            lines.append(line)

    with open(rawpath, encoding="utf-8", errors="replace") as f:
        for raw in f:
            try:
                ev = json.loads(raw)
            except ValueError:
                continue
            for name, args in _calls(ev):
                if name not in allowed:
                    serious = True
                    add("‼", "不该有的工具", name, _short(args))
                    continue
                if name in WEB_TOOLS:                        # 联网的由 web_audit 列
                    continue
                if name in WRITE_TOOLS:
                    if not _write_ok(name, args, cwd, out):
                        serious = True
                        add("‼", "写到结果文件夹以外", name, _short(args))
                    continue
                paths = _targets(name, args)
                for p in paths or []:
                    try:
                        w = _where(p, cwd, cfg)
                    except (ValueError, OSError):
                        paths = None
                        break
                    if w == "严重":
                        serious = True
                        add("‼", "严重越界", name, p)
                    elif w:
                        add(" ", "普通越界", name, p)
                if paths is None:
                    add("？", "没判出来", name, _short(args))
    return lines, serious


def finish(flag, err, rc, final, u, rawpath):
    if flag.get("why"):
        status = flag["why"]
    elif err or rc != 0 or not final:
        status = "失败"
    else:
        status = "完成"
    if status == "失败" and not err:
        try:
            with open(rawpath + ".err", encoding="utf-8", errors="replace") as f:
                err = f.read().strip()[-600:] or None
        except OSError:
            pass
    return {"status": status, "err": err, "final": final or "", "u": u,
            "killed": flag.get("why"), "notes": flag.get("notes", [])}


# ---------- 操作清单：apply / undo ----------
# 工人只交清单，总工审过后由这里执行。只支持 mkdir / move / rename：不删除、不覆盖。
# 任何一条校验不过，整份拒绝，一条都不执行。

UNDO_DIR = os.path.join(OUT, "撤销")


def _key(p):
    """APFS 默认不区分大小写、会做 Unicode 归一化：比较用 NFC + 小写。"""
    return unicodedata.normalize("NFC", p).lower()


def _protected():
    """保护清单里的路径（展开通配）。"""
    lst = os.path.join(os.path.dirname(BASE), "bin", "保护清单.txt")
    res = set()
    try:
        with open(lst, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    for g in glob.glob(_p(line)) or [_p(line)]:
                        a = os.path.abspath(g)
                        res.add(_key(a))
                        # 清单里的路径可能经过软链接（如 /tmp → /private/tmp），apply / undo 比的是解析过的真实路径：
                        # 上级目录解析后的写法也算（最后一级不跟进去，锁的是链接本身）
                        res.add(_key(os.path.join(os.path.realpath(os.path.dirname(a)), os.path.basename(a))))
    except OSError:
        pass
    return res


def _locked(path):
    try:
        return bool(os.lstat(path).st_flags & (stat.UF_IMMUTABLE | stat.SF_IMMUTABLE))
    except (OSError, AttributeError):
        return False


class Plan(object):
    """按顺序模拟清单执行后的目录状态，用来查同名、父目录是否存在。"""

    def __init__(self, root, cfg):
        self.root, self.cfg = root, cfg
        self.added, self.gone = {}, set()   # key -> 是否目录；已移走的 key
        self.protected = _protected()

    def path(self, rel, i, what):
        if not isinstance(rel, str) or not rel.strip():
            raise Refused("第 %d 条：%s 为空。" % (i, what))
        if os.path.isabs(rel) or rel.startswith("~"):
            raise Refused("第 %d 条：%s 必须是相对根目录的路径：%s" % (i, what, rel))
        parts = rel.replace("\\", "/").split("/")
        if any(x in ("", ".", "..") for x in parts):
            raise Refused("第 %d 条：%s 不许含 . / .. / 空段：%s" % (i, what, rel))
        full = os.path.join(self.root, *parts)
        # 逐级检查：已存在的每一级都不能是软链接、不能是加锁条目
        cur = self.root
        for x in parts:
            cur = os.path.join(cur, x)
            if os.path.islink(cur):
                raise Refused("第 %d 条：%s 路径经过软链接：%s" % (i, what, cur))
            if _key(cur) in self.protected or _locked(cur):
                raise Refused("第 %d 条：%s 碰到受保护/加锁路径：%s" % (i, what, cur))
        for d in self.cfg["deny_roots"]:
            if _inside(_key(full), _key(_real(d))):
                raise Refused("第 %d 条：%s 在禁区内：%s" % (i, what, full))
        return full

    def exists(self, full):
        k = _key(full)
        if k in self.added:
            return True
        if k in self.gone:
            return False
        par, name = os.path.split(full)
        try:
            return any(_key(n) == _key(name) for n in os.listdir(par))
        except OSError:
            return False

    def isdir(self, full):
        k = _key(full)
        if k in self.added:
            return self.added[k]
        return k not in self.gone and os.path.isdir(full)

    def check(self, i, op):
        kind = op.get("op") if isinstance(op, dict) else None
        if kind not in ("mkdir", "move", "rename"):
            raise Refused("第 %d 条：不支持的操作 %r（只允许 mkdir / move / rename）。" % (i, kind))
        to = self.path(op.get("to"), i, "to")
        if not self.isdir(os.path.dirname(to)):
            raise Refused("第 %d 条：目标的上级目录不存在：%s" % (i, os.path.dirname(to)))
        if _locked(os.path.dirname(to)):
            raise Refused("第 %d 条：目标的上级目录已加锁：%s" % (i, os.path.dirname(to)))
        if self.exists(to):
            raise Refused("第 %d 条：目标已存在（不区分大小写）：%s" % (i, to))
        if kind == "mkdir":
            self.added[_key(to)] = True
            return {"op": "mkdir", "to": to}
        frm = self.path(op.get("from"), i, "from")
        if not self.exists(frm) or _key(frm) in self.added:
            raise Refused("第 %d 条：源不存在，或是本清单前面才建/移来的：%s" % (i, frm))
        if _inside(_key(to), _key(frm)):
            raise Refused("第 %d 条：不能把目录移进它自己里面：%s" % (i, frm))
        if _locked(os.path.dirname(frm)):
            raise Refused("第 %d 条：源所在目录已加锁：%s" % (i, os.path.dirname(frm)))
        if kind == "rename" and _key(os.path.dirname(frm)) != _key(os.path.dirname(to)):
            raise Refused("第 %d 条：rename 只能在同一目录内改名，跨目录请用 move。" % i)
        self.gone.add(_key(frm))
        self.added[_key(to)] = os.path.isdir(frm)
        return {"op": kind, "from": frm, "to": to}


def _claim(paths_of):
    """独占创建一组文件（不覆盖已有文件），返回这组路径。paths_of(六位随机十六进制) 给出这组路径；
    其中哪个已经存在，就删掉这一轮自己刚建的空文件，换个随机串重来。"""
    for _ in range(20):
        paths, made = paths_of(uuid.uuid4().hex[:6]), []
        try:
            for p in paths:
                os.close(os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o666))
                made.append(p)
            return paths
        except FileExistsError:
            for p in made:
                os.remove(p)
    raise OSError("连续 20 次撞上已有的文件名，没建成：%s" % paths[0])


def _load_ops(path):
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    ops = data.get("ops") if isinstance(data, dict) else data
    if not isinstance(ops, list) or not ops:
        raise Refused("清单里没有 ops。")
    return ops


def _save_undo(ts, root, done):
    os.makedirs(UNDO_DIR, exist_ok=True)
    path, = _claim(lambda h: (os.path.join(UNDO_DIR, "%s-%s-apply.json" % (ts, h)),))
    with open(path, "w", encoding="utf-8") as f:            # 上一行已独占建好，这里写的是自己的文件
        json.dump({"root": root, "done": done}, f, ensure_ascii=False, indent=1)
    return path


def cmd_apply(argv):
    ap = argparse.ArgumentParser(prog="waibao apply", description="照操作清单执行 mkdir / move / rename，不删除、不覆盖")
    ap.add_argument("--dir", required=True, help="根目录；清单里的路径都相对它，必须在 allow_roots 内")
    ap.add_argument("--list", required=True, help="操作清单 JSON：{\"ops\":[...]}")
    ap.add_argument("--dry-run", action="store_true", help="只校验，不执行")
    a = ap.parse_args(argv)
    cfg = load_cfg()
    root = check_dir(a.dir, cfg)
    if _key(root) == _key(HOME) or _locked(root):
        raise Refused("根目录不能是家目录或加锁目录：%s" % root)
    ops = _load_ops(a.list)
    cap = int(cfg.get("apply_max_ops", 200))
    if len(ops) > cap:
        raise Refused("清单 %d 条，超过上限 %d 条。" % (len(ops), cap))
    plan = Plan(root, cfg)
    todo = [plan.check(i, op) for i, op in enumerate(ops, 1)]
    print("[waibao] 清单校验通过：%d 条（%s）" % (len(todo), root))
    for t in todo:
        print("  %-6s %s%s" % (t["op"], (t["from"] + " → ") if "from" in t else "", t["to"]))
    if a.dry_run:
        print("[waibao] dry-run：未执行")
        return 0
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    done, err = [], None
    for t in todo:
        try:
            if t["op"] == "mkdir":
                os.mkdir(t["to"])
            else:
                if os.path.lexists(t["to"]):           # 执行瞬间再查一次，防并发
                    raise OSError("目标已存在：%s" % t["to"])
                os.rename(t["from"], t["to"])
            done.append(t)
        except OSError as e:
            err = "%s %s 失败：%s" % (t["op"], t["to"], e)
            break
    undo = _save_undo(ts, root, done)
    print("[waibao] 已执行 %d / %d 条；撤销：%s undo %s" % (len(done), len(todo), os.path.realpath(__file__), undo))
    if err:
        print("[waibao] 停在这里：%s（后面的没执行）" % err, file=sys.stderr)
        return 3
    return 0


# 撤销记录里每种操作该有的字段：只认 apply 写得出来的这几种。
UNDO_FIELDS = {"mkdir": {"op", "to"}, "move": {"op", "from", "to"}, "rename": {"op", "from", "to"}}


def _undo_path(plan, root, p, i, what):
    """撤销记录里的一条绝对路径：必须逐字以「根目录/」开头，剩下的部分按 apply 的规矩逐级查
    （不许 . / .. / 空段、不经软链接、不碰保护清单和加锁条目、不进禁区），还得和规整写法一字不差。"""
    if not isinstance(p, str) or "\x00" in p:
        raise Refused("第 %d 条：%s 不是合法路径：%r" % (i, what, p))
    if not p.startswith(root + os.sep):
        raise Refused("第 %d 条：%s 不在记录的根目录 %s 里面：%s" % (i, what, root, p))
    full = plan.path(p[len(root) + 1:], i, what)
    if full != p:
        raise Refused("第 %d 条：%s 写法不规整：%s" % (i, what, p))
    return full


def _review_undo(rec, cfg):
    """执行前整份预审撤销记录，返回要撤销的条目（apply 的顺序）。任何一条不合格就整份拒绝，一条都不执行。
    根目录按当前 预算.json 重查（allow_roots / deny_roots，不是家目录、没加锁、没经软链接），
    每条的 from / to 都必须在这个根目录里，逐级检查复用 apply 的 Plan.path。"""
    if not isinstance(rec, dict) or set(rec) != {"root", "done"}:
        raise Refused("撤销记录的结构不对：应当只有 root 和 done 两项。")
    root, done = rec["root"], rec["done"]
    if not isinstance(root, str) or not os.path.isabs(root) or "\x00" in root or not isinstance(done, list):
        raise Refused("撤销记录的结构不对：root 要是绝对路径，done 要是列表。")
    real = check_dir(root, cfg)
    if real != root:
        raise Refused("记录的根目录经过软链接或写法不规整：%s（实际是 %s）" % (root, real))
    if _key(real) == _key(HOME) or _locked(real):
        raise Refused("根目录不能是家目录或加锁目录：%s" % real)
    plan = Plan(real, cfg)
    todo = []
    for i, t in enumerate(done, 1):
        kind = t.get("op") if isinstance(t, dict) else None
        if kind not in UNDO_FIELDS or set(t) != UNDO_FIELDS[kind]:
            raise Refused("第 %d 条：不是 apply 记下的操作（只认 mkdir / move / rename 和它们的字段）：%s"
                          % (i, _short(t)))
        step = {"op": kind, "to": _undo_path(plan, real, t["to"], i, "to")}
        if kind != "mkdir":
            frm = step["from"] = _undo_path(plan, real, t["from"], i, "from")
            if _inside(_key(step["to"]), _key(frm)):
                raise Refused("第 %d 条：to 在 from 里面：%s" % (i, frm))
            if kind == "rename" and _key(os.path.dirname(frm)) != _key(os.path.dirname(step["to"])):
                raise Refused("第 %d 条：rename 的 from 和 to 不在同一目录。" % i)
        todo.append(step)
    return todo


def _desc(t):
    return "%s %s%s" % (t["op"], (t["from"] + " → ") if "from" in t else "", t["to"])


def _note_undo(record, todo, n, why):
    """撤销停在半路：在撤销记录旁边追加写明撤到了哪一步（追加，不盖掉之前几次的）。返回进度文件路径，写不成返回 None。"""
    path = record + ".撤销进度.txt"
    total, stop = len(todo), len(todo) - n          # 条目按 apply 的顺序编号，撤销从最后一条倒着来
    lines = ["== %s ==" % datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
             "撤销记录：%s（共 %d 条，从第 %d 条倒着撤）" % (os.path.abspath(record), total, total)]
    lines += ["已撤销：第 %d 条 %s" % (k, _desc(todo[k - 1])) for k in range(total, stop, -1)]
    lines.append("停在：第 %d 条 %s；原因：%s" % (stop, _desc(todo[stop - 1]), why))
    if stop > 1:
        lines.append("没执行：第 %d 条到第 1 条" % (stop - 1))
    lines.append("注意：重跑 undo 会从第 %d 条重新开始，不会跳过以前撤销过的条目（撞上就停）；剩下的可以对照上面手工处理。"
                 % total)
    try:
        with open(path, "a", encoding="utf-8") as f:
            f.write("\n".join(lines) + "\n\n")
        return path
    except OSError:
        return None


def cmd_undo(argv):
    ap = argparse.ArgumentParser(prog="waibao undo", description="按撤销记录反向恢复 apply 的操作（先整份预审）")
    ap.add_argument("record")
    a = ap.parse_args(argv)
    if not os.path.isfile(a.record):
        raise Refused("撤销记录不存在：%s" % a.record)
    try:
        with open(a.record, encoding="utf-8") as f:
            rec = json.load(f)
    except ValueError as e:
        raise Refused("撤销记录读不出来，不是 apply 写的 JSON：%s" % e)
    todo = _review_undo(rec, load_cfg())
    print("[waibao] 撤销记录预审通过：%d 条（%s）" % (len(todo), rec["root"]))
    n = 0
    for t in reversed(todo):
        why = None
        if t["op"] == "mkdir":
            try:
                os.rmdir(t["to"])                       # 只删空目录：里面有东西就停
            except OSError as e:
                why = "撤销 mkdir %s 失败（%s）" % (t["to"], e)
        else:
            par, name = os.path.split(t["from"])
            clash = os.path.isdir(par) and any(_key(x) == _key(name) for x in os.listdir(par))
            if clash or not os.path.isdir(par) or not os.path.lexists(t["to"]):
                why = "%s 无法移回 %s（原位已有同名、原目录不在或文件已不在）" % (t["to"], t["from"])
            else:
                try:
                    os.rename(t["to"], t["from"])
                except OSError as e:
                    why = "%s 移回 %s 失败（%s）" % (t["to"], t["from"], e)
        if why:
            note = _note_undo(a.record, todo, n, why)
            print("[waibao] 停：%s；已撤销 %d 条（后面的没执行）；%s"
                  % (why, n, "撤到哪一步写在 %s" % note if note else "撤销进度没写成"), file=sys.stderr)
            return 3
        n += 1
    os.rename(a.record, a.record + ".已撤销")
    print("[waibao] 已撤销 %d 条" % n)
    return 0


